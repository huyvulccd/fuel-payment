
### transactions

- GET /transactions?owner_id={ownerId}&limit={limit}&offset={offset}
- GET /transactions/{transactionCode}

### topup-history
- POST /topup-history/register
"""
request {
    ownerId: Long,
    amount: BigDecimal,
    topupMethod: String (BANK_TRANSFER | MOMO | VNPAY)
}
response {
    transactionCode: String,
    ownerId: Long,
    amount: BigDecimal,
    topupMethod: String,
    status: String,
    balanceBefore: BigDecimal,
    balanceAfter: BigDecimal
}
"""

### payment-history
- POST /payment-history/register
"""
request {
    ownerId: Long,
    orderCode: String,
    licensePlate: String,
    amount: BigDecimal
}
response {
    transactionCode: String,
    ownerId: Long,
    orderCode: String,
    licensePlate: String,
    amount: BigDecimal,
    status: String,
    balanceBefore: BigDecimal,
    balanceAfter: BigDecimal
}
"""

### transfer-history
- POST /transfer-history/register
"""
request {
    senderId: Long,
    receiverId: Long,
    amount: BigDecimal,
    message: String (optional)
}
response {
    transactionCode: String,
    senderId: Long,
    receiverId: Long,
    amount: BigDecimal,
    message: String,
    status: String,
    senderBalanceBefore: BigDecimal,
    senderBalanceAfter: BigDecimal,
    receiverBalanceBefore: BigDecimal,
    receiverBalanceAfter: BigDecimal
}
"""